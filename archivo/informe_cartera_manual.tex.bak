F4 & 0{,}38 & 0{,}23 & 0{,}08 & 1{,}00 & 0{,}02 & 0{,}30 & 0{,}13 & 0{,}02 \\
F5 & $-$0{,}03 & $-$0{,}07 & $-$0{,}16 & 0{,}02 & 1{,}00 & 0{,}40 & $-$0{,}02 & $-$0{,}25 \\
F6 & 0{,}11 & 0{,}14 & $-$0{,}05 & 0{,}30 & 0{,}40 & 1{,}00 & 0{,}02 & $-$0{,}08 \\
F7 & 0{,}30 & 0{,}43 & 0{,}20 & 0{,}13 & $-$0{,}02 & 0{,}02 & 1{,}00 & 0{,}33 \\
F8 & 0{,}45 & 0{,}21 & 0{,}44 & 0{,}02 & $-$0{,}25 & $-$0{,}08 & 0{,}33 & 1{,}00 \\
\bottomrule
\end{tabular}}
\end{table}

\begin{figure}[htbp]
