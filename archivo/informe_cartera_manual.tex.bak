\caption{Mapa de calor de la matriz de correlaciones semanales de la tabla~\ref{tab:correlaciones}. El
bloque de crédito (F1, F2, F7, F8) destaca en tonos cálidos; F5 (BlackRock Systematic) aparece como la
posición más neutra frente al resto.}
\label{fig:correlaciones}
\end{figure}

